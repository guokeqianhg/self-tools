# 复制为 .env 后按需配置；.env 不会提交到版本库。

# OpenAI 兼容 LLM 服务（可选；三项均未配置时，AI 能力降级为本地检索和确定性模板）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Web 管理台端口
PORT=8080

# RAG 语义检索（本地模型；首次运行会下载模型，加载失败时自动退化为关键词检索）
EMBEDDING_MODEL=Xenova/bge-base-zh-v1.5
RERANKER_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
EMBEDDING_PROVIDER=local

# Git 发布身份（新增、编辑、删除等发布操作提交到你自行配置的仓库时使用）
GIT_USER_NAME=
GIT_USER_EMAIL=

# 知识治理通知（可选；填写兼容的企业微信机器人 Webhook）
WECOM_WEBHOOK=

# 体检自动化开关：设为 1 可关闭服务内每周一自动体检
GOVERN_OFF=

# 可选：iWiki MCP 导入。由部署方填写所在环境的 MCP 地址、页面基础地址和个人只读令牌。
IWIKI_PAT=
IWIKI_MCP_URL=
IWIKI_PAGE_BASE_URL=

# 可选：企业微信聊天归档来源。上游服务负责验签、解密和落盘；知识库仅以只读权限扫描。
WEWORK_SOURCE_RECORD_DIR=
WEWORK_SOURCE_MEDIA_DIR=
WEWORK_SOURCE_POLL_SECONDS=30
WEWORK_RETAIN_DAYS=30
WEWORK_AUTO_DRAFT=1
